# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME=SMRITI
APP_PORT=8000

# Central Database Configuration
DATABASE_URL=sqlite:///./smriti_cloud.db
# DATABASE_URL=postgresql://smriti_user:smriti_password@localhost:5432/smriti_db

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Offline Sync & Risk Engine Settings
MAX_SYNC_BATCH_SIZE=500
RISK_THRESHOLD_ATTENTION=60
RISK_THRESHOLD_MONITOR=30
