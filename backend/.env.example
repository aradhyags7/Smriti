# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="SMRITI Backend"
APP_NAME=SMRITI
APP_PORT=8000

# Database Configuration
DATABASE_URL=postgresql://smriti_user:smriti_password@localhost:5432/smriti_db

# Security & Tokens
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Offline Sync & Early-Warning Thresholds
MAX_SYNC_BATCH_SIZE=500
RISK_THRESHOLD_ATTENTION=60
RISK_THRESHOLD_MONITOR=40
